# Existing backend services
DB_HOST=mysql
DB_PORT=3306
DB_NAME=capstone
DB_USERNAME=root
DB_PASSWORD=replace_with_database_password
REDIS_HOST=redis
REDIS_PORT=6379

# Spring AI chatbox (disabled until all dependencies are ready)
CHAT_AI_ENABLED=false
CHAT_MODEL_PROVIDER=none
CHAT_EMBEDDING_PROVIDER=none
CHAT_VECTOR_STORE=none

# Enable with these values:
# CHAT_AI_ENABLED=true
# CHAT_MODEL_PROVIDER=google-genai
# CHAT_EMBEDDING_PROVIDER=ollama
# CHAT_VECTOR_STORE=qdrant
GEMINI_API_KEY=replace_with_gemini_api_key
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PULL_MODEL_STRATEGY=never
QDRANT_HOST=qdrant
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=healthsync_medical_knowledge
QDRANT_USE_TLS=false
CHAT_KNOWLEDGE_DIR=/app/data/knowledge
CHAT_RETRIEVAL_TOP_K=5
CHAT_SIMILARITY_THRESHOLD=0.65
