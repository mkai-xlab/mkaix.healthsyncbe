meta {
  name: Create Chat Session
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/chat/sessions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "Knee OA discussion",
    "examinationId": null
  }
}

vars:post-response {
  chatSessionId: res.body.id
}

tests {
  test("creates an owned chat session", function() {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("number");
    expect(res.body.active).to.equal(true);
  });
}
