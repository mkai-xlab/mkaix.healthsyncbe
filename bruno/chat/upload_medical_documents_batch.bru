meta {
  name: Upload Medical Documents Batch
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/knowledge-documents/upload/batch
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  files: @file(kien_thuc_y_khoa.txt)
  files: @file(kien_thuc_y_khoa_en.txt)
  accessScope: ALL
}

tests {
  test("returns one result for each submitted document", function() {
    expect(res.status).to.equal(202);
    expect(res.body.totalFiles).to.equal(2);
    expect(res.body.acceptedCount + res.body.rejectedCount).to.equal(2);
    expect(res.body.items).to.be.an("array").that.has.lengthOf(2);
  });
}
