meta {
  name: Ask Business Question
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/chat/ask
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "question": "Hom nay toi co bao nhieu ca kham?"
  }
}

tests {
  test("returns a routed answer with sources", function() {
    expect(res.status).to.equal(200);
    expect(res.body.route).to.be.oneOf(["BUSINESS_DATA", "CLARIFICATION"]);
    expect(res.body.answer).to.be.a("string");
    expect(res.body.sources).to.be.an("array");
  });
}
