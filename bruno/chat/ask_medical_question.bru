meta {
  name: Ask Medical Question
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/chat/ask
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "question": "Giai thich y nghia cua Kellgren-Lawrence grade 3."
  }
}

tests {
  test("returns medical sources or an insufficient-evidence warning", function() {
    expect(res.status).to.equal(200);
    expect(res.body.route).to.equal("MEDICAL_RAG");
    expect(res.body.warning).to.be.a("string");
  });
}
