meta {
  name: Get Indexed Knowledge Documents
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/knowledge-documents?status=INDEXED&page=0&size=20&sort=indexedAt,desc
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns only indexed documents", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("object");
    expect(res.body.content).to.be.an("array");

    res.body.content.forEach(function(document) {
      expect(document.status).to.equal("INDEXED");
      expect(document.indexedAt).to.be.a("string");
      expect(document.chunkCount).to.be.a("number");
    });
  });
}
