tests {
  test("returns the original document as an attachment", function() {
    expect(res.status).to.equal(200);
    expect(res.headers["content-disposition"]).to.include("attachment");
    expect(res.headers["content-type"]).to.match(/application\/(pdf|octet-stream|msword)|text\/(plain|html)|application\/vnd\.openxmlformats-officedocument\.wordprocessingml\.document/);
  });
}
