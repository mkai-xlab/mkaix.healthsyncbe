meta {
  name: Reject Non-Medical Document
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/knowledge-documents/upload
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  file: @file(non-medical-document.txt)
  title: Non-medical test document
  accessScope: ALL
}

tests {
  test("rejects content that is not medical knowledge", function() {
    expect(res.status).to.equal(400);
    expect(res.body.message).to.include("Document rejected:");
  });
}
