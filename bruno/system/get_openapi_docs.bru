meta {
  name: Get OpenAPI Docs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v3/api-docs
  body: none
  auth: none
}

tests {
  test("returns generated OpenAPI document", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("paths");
    expect(res.body.paths).to.have.property("/knowledge-documents/{id}/reindex");
  });
}
