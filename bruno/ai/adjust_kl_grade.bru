meta {
  name: Adjust KL Grade
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/ai/results/19/kl-grade
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "confirmedKlGrade": 3,
    "reviewNote": "Clinical findings support KL grade 3"
  }
}

tests {
  test("overrides KL grade while preserving AI prediction", function() {
    expect(res.status).to.equal(200);
    expect(res.body.predictedKlGrade).to.be.a("number");
    expect(res.body.confirmedKlGrade).to.equal(3);
    expect(res.body.decision).to.equal("DOCTOR_ADJUSTED");
  });
}
