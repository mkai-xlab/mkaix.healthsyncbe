meta {
  name: Generate PDF Report
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/examinations/{{examinationId}}/generate-report
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  examinationId: 1
}

vars:post-response {
  reportId: res.body.reportId
}

tests {
  test("returns report metadata", function() {
    expect(res.status).to.equal(200);
    expect(res.body.reportId).to.be.a("number");
    expect(res.body.previewUrl).to.include("/preview");
    expect(res.body.downloadUrl).to.include("/download");
  });
}​