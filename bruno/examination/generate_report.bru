meta {
  name: Generate PDF Report
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/examinations/{{examinationId}}/generate-report
  body: none
  auth: bearer
}

params:query {
  isPersonal: true
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  examinationId: 9
}

tests {
  test("returns report metadata", function() {
    expect(res.status).to.equal(200);
    expect(res.body.reportId).to.be.a("number");
    expect(res.body.previewUrl).to.equal(`/api/v1/reports/${res.body.examinationId}/preview`);
    expect(res.body.downloadUrl).to.equal(`/api/v1/reports/${res.body.examinationId}/download`);
  });
}

docs {
  Generates the X-ray report PDF ("PHIEU CHUP XQUANG") with no doctor edits: every field keeps the
  pre-filled value, including the result block composed from the confirmed Kellgren-Lawrence
  grades. An already generated report is returned untouched. The normal flow is
  GET /examinations/{id}/report-draft followed by "Confirm And Generate PDF Report".
}
