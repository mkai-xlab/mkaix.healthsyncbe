meta {
  name: Preview PDF Report
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/reports/{{examinationId}}/preview
  body: none
  auth: bearer
}

query {
  isPersonal: true
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  examinationId: 1
}

tests {
  test("returns PDF inline", function() {
    expect(res.status).to.equal(200);
    expect(res.headers["content-type"]).to.include("application/pdf");
    expect(res.headers["content-disposition"]).to.include("inline");
  });
}
