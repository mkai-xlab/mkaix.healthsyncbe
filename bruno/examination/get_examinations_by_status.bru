meta {
  name: get_examinations_by_status
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/examinations/status?status=NEED_VERIFY
  body: none
  auth: bearer
}

params:query {
  isPersonal: true
  status: NEED_VERIFY
  ~page: 0
  ~size: 10
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  accessToken: ""
}
