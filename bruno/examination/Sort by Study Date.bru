meta {
  name: Sort by Study Date
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/examinations/sort/study-date?direction=desc&page=0&size=10
  body: none
  auth: bearer
}

params:query {
  isPersonal: true
  direction: desc
  page: 0
  size: 10
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  accessToken: ""
}
