meta {
  name: get_examinations_by_grade
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/examinations/grade?grade=3
  body: none
  auth: bearer
}

params:query {
  isPersonal: true
  grade: 3
  ~page: 0
  ~size: 10
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  accessToken: ""
}