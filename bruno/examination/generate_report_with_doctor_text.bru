meta {
  name: Confirm And Generate PDF Report
  type: http
  seq: 36
}

post {
  url: {{baseUrl}}/examinations/{{examinationId}}/generate-report
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "findings": [
      "Gối phải: Thoái hóa khớp gối độ 0 (Kellgren-Lawrence).",
      "Gối trái: Không thoái hóa khớp gối (Kellgren-Lawrence độ 1)."
    ],
    "conclusion": "Cần ăn nhiều vào.",
    "signaturePlace": "Hà Nội",
    "signatureDate": "07/05/2026"
  }
}

vars:pre-request {
  examinationId: 9
}

tests {
  test("renders the confirmed form", function() {
    expect(res.status).to.equal(200);
    expect(res.body.reportId).to.be.a("number");
    expect(res.body.fileName).to.match(/\.pdf$/);
    expect(res.body.previewUrl).to.equal(`/api/v1/reports/${res.body.examinationId}/preview`);
  });
}

docs {
  Step 2 of the report flow: the doctor presses confirm on the preview and the PDF is rendered
  from the values below. Every field is optional and falls back to the pre-filled value, so the
  frontend may send only what the doctor actually changed - typically just findings and
  conclusion. Sending a body always re-renders the PDF, even when the examination already has a
  report.
  
  The letterhead and Khoa are fixed by app.report.* configuration, and the name on the signature
  line is always the authenticated doctor, so none of them are accepted here.
}
​