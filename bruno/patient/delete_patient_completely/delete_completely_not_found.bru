tests {
  test("unknown patientCode returns 404", function() {
    expect(res.status).to.equal(404);
  });
}

docs {
  Calls the full-purge endpoint with a patientCode that does not exist. Expects 404
  (ResourceNotFoundException), confirming the lookup runs before any deletion happens.
}
