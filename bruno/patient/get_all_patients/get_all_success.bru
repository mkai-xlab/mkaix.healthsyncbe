meta {
  name: Get All Patients
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/patients?size=10&page=0
  body: none
  auth: bearer
}

params:query {
  size: 10
  page: 0
  ~keyword: john
  ~dateOfBirth: 1990-01-01
  ~gender: MALE
  ~phone: 0123456789
  ~email: test@example.com
  ~address: Hanoi
  ~emergencyContactName: Jane
  ~emergencyContactPhone: 0987654321
  ~statuses: ACTIVE,INACTIVE
  ~severities: 1
  ~isPersonal: true
  ~sort: createdAt,desc
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  accessToken: 
  ~accessToken: your_custom_token_here
}
​