meta {
  name: Create Patient
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/patients
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "fullName": "Patient A",
    "dateOfBirth": "1990-01-01",
    "gender": "MALE",
    "phone": "0123456789",
    "email": "patient.a@healthsync.com"
  }
}​